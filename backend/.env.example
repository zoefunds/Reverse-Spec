# Copy to backend/.env for local development. Never commit real secrets.
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://reversespec:reversespec@localhost:5432/reversespec
JWT_SECRET=dev-only-secret-change-me
CORS_ORIGINS=http://localhost:3000
GENLAYER_NETWORK=studionet
GENLAYER_CONTRACT_ADDRESS=0x1DD671F0b8Be9e6fB7e7F2078261e1B840AF4439
INDEXER_ENABLED=true
INDEXER_INTERVAL_SECONDS=30

# --- Base Sepolia USDC escrow + relayer (backend/relayer/) ------------------
# Funding currency as of v1: USDC on Base Sepolia, not native GEN. GenLayer
# only judges and computes payout instructions; backend/relayer/ bridges a
# confirmed Base Sepolia deposit into a GenLayer bounty opening, and a
# GenLayer consensus outcome into a real USDC settlement. See
# docs/ARCHITECTURE.md for the full split-custody design.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Deployed via contracts/base/deploy.js — see README for the current address.
REVERSE_SPEC_ESCROW_ADDRESS=
# Throwaway relayer key. Its address is BOTH the escrow's `relayer` and the
# GenLayer contract's `relayer` (rotatable via set_relayer/setRelayer).
# NEVER commit a real value here — set it as a deploy-time secret only.
BASE_SEPOLIA_RELAYER_PRIVATE_KEY=
BASE_SEPOLIA_STAKE_CONFIRMATIONS=5
RELAYER_POLL_INTERVAL_MS=30000
